{
  "name": "craftcms/stripe",
  "description": "Stripe Integration for Craft CMS",
  "type": "craft-plugin",
  "keywords": [
    "cms",
    "craftcms",
    "laravel",
    "stripe"
  ],
  "homepage": "https://github.com/craftcms/stripe",
  "license": "MIT",
  "authors": [
    {
      "name": "Pixel & Tonic",
      "homepage": "https://pixelandtonic.com/"
    }
  ],
  "support": {
    "email": "support@craftcms.com",
    "issues": "https://github.com/craftcms/stripe/issues?state=open",
    "source": "https://github.com/craftcms/stripe",
    "docs": "https://github.com/craftcms/stripe/blob/2.x/README.md",
    "rss": "https://github.com/craftcms/stripe/releases.atom"
  },
  "require": {
    "php": "^8.5",
    "craftcms/cms": "^6.0.0-beta.1",
    "stripe/stripe-php": "^13|^14"
  },
  "require-dev": {
    "larastan/larastan": "^3.13",
    "laravel/pint": "^1.22",
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^5.0",
    "pestphp/pest-plugin-laravel": "^5.0",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "CraftCms\\Stripe\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CraftCms\\Stripe\\Tests\\": "tests/",
      "CraftCms\\Cms\\Database\\Factories\\": "vendor/craftcms/cms/database/Factories/"
    }
  },
  "extra": {
    "class": "CraftCms\\Stripe\\Plugin",
    "handle": "stripe",
    "name": "Stripe",
    "description": "Sync and extend Stripe products and subscriptions.",
    "developer": "Pixel & Tonic",
    "documentationUrl": "https://github.com/craftcms/stripe/blob/2.x/README.md"
  },
  "scripts": {
    "check-cs": "pint --test",
    "fix-cs": "pint",
    "phpstan": "phpstan --memory-limit=1G",
    "test": "pest"
  },
  "config": {
    "platform": {
      "php": "8.5"
    },
    "sort-packages": true,
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
